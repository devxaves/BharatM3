# ── Database ──────────────────────────────────────────────────────────────
# Neon serverless database. When unset, UniMat
# falls back to an embedded PGlite Postgres at ./.data/pglite so the demo never
# depends on a live external service (PRD principle 6).
# DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/unimat?sslmode=require

# Local PGlite data directory (only used when DATABASE_URL is unset)
# PGLITE_DATA_DIR=./.data/pglite

# ── Embeddings (optional) ────────────────────────────────────────────────
# local  = deterministic hashed n-gram embeddings (default, zero dependency)
# openai = text-embedding-3-small with dimensions=256 (falls back to local on error)
EMBEDDINGS_PROVIDER=local
# OPENAI_API_KEY=sk-...

# ── LLM assist (optional, non-blocking) ──────────────────────────────────
# Only drafts description wording / natural-language explanations for steward review.
# Never decides equivalence. Leave off for the offline demo.
LLM_ASSIST_ENABLED=false
